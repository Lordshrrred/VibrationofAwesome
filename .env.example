# ─────────────────────────────────────────────────────────────────────────────
# vibrationofawesome.com — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (AURA Premium subscriptions + Field Guide ebook) ──────────────────
# Keys found at: https://dashboard.stripe.com/apikeys (use test keys during dev)
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
#
# Webhook: create at https://dashboard.stripe.com/webhooks
#   Endpoint URL: https://vibrationofawesome.vercel.app/api/stripe-webhook
#   Events: checkout.session.completed, customer.subscription.deleted,
#            customer.subscription.updated, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
#
# AURA Premium: create a recurring price at $12/mo in Stripe Dashboard,
#   then paste the price_... ID here. This is REQUIRED for checkout to work.
STRIPE_PRICE_ID_AURA_PREMIUM=price_...
#
# Field Guide ebook: create a one-time price at your desired amount,
#   then paste the price_... ID here.
STRIPE_PRICE_ID_USER_MANUAL=price_...
#
# Legacy alias (still read as fallback if AURA_PREMIUM is not set)
STRIPE_PRICE_ID=price_...
# Optional Aura pricing override used by setup-stripe.js
STRIPE_AURA_PREMIUM_AMOUNT=12
# Optional Stripe Tax configuration
# Turn on only after you configure business address + registrations in Stripe Tax.
STRIPE_ENABLE_AUTOMATIC_TAX=false
# Set product-specific tax codes if you want to avoid relying on the dashboard default.
STRIPE_TAX_CODE_AURA_PREMIUM=
STRIPE_TAX_CODE_USER_MANUAL=
# Choose how tax is presented. Typical values: exclusive or inclusive.
STRIPE_TAX_BEHAVIOR=exclusive

# ── Anthropic (required for post generation + captions) ───────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ideogram (AI-generated Pinterest images) ──────────────────────────────────
# Get a key at: https://ideogram.ai/manage-api
# If not set, Pinterest uses Pexels stock photos instead.
# ~$0.02/image with V_2_TURBO model (used by default for speed)
IDEOGRAM_API_KEY=

# ── Vercel deployment (for push-env-to-vercel.js) ─────────────────────────────
# VERCEL_TOKEN:      https://vercel.com/account/tokens
# VERCEL_PROJECT_ID: Vercel Dashboard → your project → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_

# ── NASA APOD (astronomy images - free key at api.nasa.gov, instant via email) ─────
# Without a key DEMO_KEY is used automatically (30 req/hr, 50/day - fine for personal use)
NASA_API_KEY=your_nasa_api_key_here

# ── Dashboard password ────────────────────────────────────────────────────────
# Used to protect /dashboard/. Run syndicate.js once after setting this and
# it will auto-generate static/_data/dashboard-config.json with the SHA-256 hash.
DASHBOARD_PASSWORD=your_secure_dashboard_password
# Optional: when this is set, /admin/ will use a backend save broker instead of
# asking the browser for a GitHub write token.
EDITOR_API_BASE=https://vibrationofawesome.vercel.app/api

# Backend-only vars for the secure Post Studio save broker.
# Keep these on Netlify (or any future backend host), never in the public .env file.
EDITOR_SESSION_SECRET=replace_with_a_long_random_string
EDITOR_ALLOWED_ORIGINS=https://vibrationofawesome.com,https://www.vibrationofawesome.com,https://vibrationofawesome.vercel.app,http://localhost:8888,http://localhost:1313
GITHUB_EDITOR_TOKEN=github_token_with_repo_contents_write_access
GITHUB_EDITOR_REPO=Lordshrrred/VibrationofAwesome
GITHUB_EDITOR_BRANCH=main

# ── VOA Feeder trigger ───────────────────────────────────────────────────────
# Personal Access Token with access to dispatch workflows in Lordshrrred/VOA_Feeder.
# Used by generate-post.js and drip-publish.js to fire the feeder workflow.
VOA_FEEDER_TRIGGER_TOKEN=your_github_pat_for_voa_feeder

# ── Bluesky ───────────────────────────────────────────────────────────────────
# Handle: your full handle e.g. vibrationofawesome.bsky.social
# App Password: generate one at https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password-here

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Instance: full URL e.g. https://mastodon.social
# Access Token: generate at Settings > Development > New Application
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# ── Facebook / Meta ───────────────────────────────────────────────────────────
# App credentials (needed for long-lived token exchange — optional but recommended)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# VOA Facebook Page
META_PAGE_ID_VOA=your_voa_facebook_page_id
META_PAGE_TOKEN_VOA=your_voa_page_access_token

# EarthStar Facebook Page
META_PAGE_ID_EARTHSTAR=your_earthstar_facebook_page_id
META_PAGE_TOKEN_EARTHSTAR=your_earthstar_page_access_token

# ── Pinterest ─────────────────────────────────────────────────────────────────
# Pinterest publishing routes through Publer.
# VOA Pinterest account (Publer ID): 6a052b620ce3c7cac0c7ebac (@awesomevibe)
# ESR Pinterest account (Publer ID): 673d1b7587c3c20ee4d074c6 (Earthstarrising11 ~ do NOT use for VOA blog)
#
# Board routing: the engine selects a board per-post based on content type.
# Set the per-board IDs below so posts land on the right board automatically.
# Resolution order: per-board env var -> Publer name-match API -> DEFAULT_ID -> "Vibration of Awesome"
#
# To discover board IDs: node scripts/syndicate.js --lane boom --slug any-slug (logs selected board)
PUBLER_PINTEREST_ACCOUNT_ID=6a052b620ce3c7cac0c7ebac
PUBLER_PINTEREST_BOARD_PURPOSE_AND_DIRECTION_ID=
PUBLER_PINTEREST_BOARD_DOPAMINE_DETOX_ID=
PUBLER_PINTEREST_BOARD_NERVOUS_SYSTEM_RESET_ID=
PUBLER_PINTEREST_BOARD_CONSCIOUS_CREATOR_TOOLS_ID=
PUBLER_PINTEREST_BOARD_FIELD_GUIDE_ID=
PUBLER_PINTEREST_BOARD_EARTHSTAR_ID=
PUBLER_PINTEREST_BOARD_EMPOWER_THYSELF_ID=
PUBLER_PINTEREST_BOARD_DEFAULT_ID=641129765641663037
# ^^ hard-coded fallback = "Vibration of Awesome" board on @awesomevibe

# ── Dev.to ────────────────────────────────────────────────────────────────────
# Generate at https://dev.to/settings/extensions (API Keys section)
DEVTO_API_KEY=your_devto_api_key

# ── Tumblr ────────────────────────────────────────────────────────────────────
# Create app at https://www.tumblr.com/oauth/apps
# Blog name: your-blog (without .tumblr.com)
TUMBLR_CONSUMER_KEY=your_tumblr_consumer_key
TUMBLR_CONSUMER_SECRET=your_tumblr_consumer_secret
TUMBLR_TOKEN=your_tumblr_oauth_token
TUMBLR_TOKEN_SECRET=your_tumblr_oauth_token_secret
TUMBLR_BLOG_NAME=your-tumblr-blog-name

# ── Instagram + Threads (via Publer) ─────────────────────────────────────────
# Publer handles Instagram and Threads posting.
# API key: https://app.publer.com/settings/api
#
# ACCOUNT IDs ~ these must point to VOA accounts, NOT EarthStarRising accounts.
# Verify by running: node scripts/syndicate.js --lane boom --slug any-slug
# The routing log shows "[VOA]" or "[⚠ not VOA]" for each Publer account.
#
# Known Publer account IDs (discovered 2026-05-15):
#   VOA Instagram:           6a0698ee1f0e47d9f3f18a43  ← use this
#   ESR Instagram:           673d135042eebd4131d07ba1  ← do NOT use for VOA blog
#   VOA Threads:             6a069b7979cc0b32f3235166  ← use this
#   ESR Threads:             673d1796bb898aa82fd07bc2  ← do NOT use for VOA blog
PUBLER_API_KEY=your_publer_api_key
PUBLER_WORKSPACE_ID=your_publer_workspace_id
PUBLER_INSTAGRAM_ACCOUNT_ID=6a0698ee1f0e47d9f3f18a43
PUBLER_THREADS_ACCOUNT_ID=6a069b7979cc0b32f3235166
# ── Direct WordPress.com API ─────────────────────────────────────────────────
# Register a WordPress.com app and use scripts/get-wordpress-oauth-token.py
# Official docs:
#   https://developer.wordpress.com/docs/api/oauth2/
#   https://developer.wordpress.com/docs/api/1.1/post/sites/%24site/posts/new/
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
WORDPRESS_REDIRECT_URI=http://localhost:9878/callback
WORDPRESS_SCOPE=posts media
WORDPRESS_BLOG=https://earthstarrisingsun.wordpress.com
WORDPRESS_USERNAME=
# Use an Application Password here if your WordPress.com account has 2FA enabled.
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_OAUTH2_TOKEN=
# Direct API categories/tags can be names or slugs; comma-separated is fine.
WORDPRESS_CATEGORY_NAMES=EarthStar Rising
WORDPRESS_TAG_NAMES=

# ── VOA Feeder trigger ────────────────────────────────────────────────────────
# Personal access token used to fire repository_dispatch events to Lordshrrred/VOA_Feeder.
VOA_FEEDER_TRIGGER_TOKEN=your_voa_feeder_trigger_token

# ── Facebook (user token) ─────────────────────────────────────────────────────
# Run `node scripts/get-facebook-token.js` to generate a long-lived user token
# and individual page tokens. Page tokens from long-lived user tokens never expire.
# META_USER_TOKEN refreshed via that script (valid ~60 days).
META_USER_TOKEN=your_meta_user_long_lived_token
