# ── Vibration of Awesome — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git. It is already in .gitignore.

# ── Anthropic (Claude API) ─────────────────────────────────────────────────────
# Required for: generate-post.js, syndicate.js, seo-research.js
# Get it at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Facebook / Instagram (Meta Graph API) ──────────────────────────────────────
# Required for: syndicate.js (Facebook + Instagram posting)
# Get these via: https://developers.facebook.com
# You need a Facebook Page and a connected Instagram Business account.
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── X / Twitter (API v2) ───────────────────────────────────────────────────────
# Required for: syndicate.js (Twitter thread posting)
# Get these via: https://developer.twitter.com
# You need Elevated access and a project/app with Read+Write permissions.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
