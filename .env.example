# ─────────────────────────────────────────────────────────────────────────────
# vibrationofawesome.com — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────
# Hosting:
#   Static site → GitHub Pages (deployed by .github/workflows/hugo.yml on push to main)
#   Serverless /api/* → Vercel (auto-deploys via Vercel dashboard webhook)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (required for post generation + captions) ───────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ideogram (AI-generated Pinterest images — optional) ───────────────────────
# Get a key at: https://ideogram.ai/manage-api
# If not set, Pinterest uses Pexels stock photos instead.
# ~$0.02/image with V_2_TURBO model (default for speed)
IDEOGRAM_API_KEY=
IDEOGRAM_DEFAULT_MODEL=V_2_TURBO   # fast + affordable (~$0.02/image)
IDEOGRAM_DEFAULT_STYLE=DESIGN       # bold graphic, good for Pinterest/Instagram
IDEOGRAM_PREMIUM_MODEL=V_2          # higher quality (~$0.08/image) — not used by default
IDEOGRAM_PREMIUM_STYLE=AUTO         # let Ideogram pick style for premium model

# ── Pexels (stock photo fallback for all platform images) ─────────────────────
# Get a key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── NASA APOD (astronomy images) ──────────────────────────────────────────────
# Without a key DEMO_KEY is used (30 req/hr, 50/day — fine for personal use)
# Get a free key instantly at: https://api.nasa.gov
NASA_API_KEY=your_nasa_api_key_here

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Protects /dashboard/. SHA-256 hash auto-generated on first syndicate run.
DASHBOARD_PASSWORD=your_secure_dashboard_password

# ── Stripe (AURA Premium subscriptions + ebooks) ──────────────────────────────
# Keys: https://dashboard.stripe.com/apikeys (use test keys in dev)
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Webhook: https://dashboard.stripe.com/webhooks
#   Endpoint URL: https://vibrationofawesome.vercel.app/api/stripe-webhook
#   Events: checkout.session.completed, customer.subscription.deleted,
#            customer.subscription.updated, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# AURA Premium — create a recurring price at $12/mo in Stripe Dashboard
STRIPE_PRICE_ID_AURA_PREMIUM=price_...
# Field Guide / User Manual ebook — create a one-time price
STRIPE_PRICE_ID_USER_MANUAL=price_...
# Legacy alias (read as fallback if AURA_PREMIUM is not set)
STRIPE_PRICE_ID=price_...
# ── Stripe Tax (optional — only set these if you activate Stripe Tax) ──────────
# Turn on AFTER configuring business address + registrations in the Stripe Tax dashboard.
STRIPE_ENABLE_AUTOMATIC_TAX=false
# Product tax codes override the Stripe Dashboard default — leave blank to use the dashboard default.
STRIPE_TAX_CODE_AURA_PREMIUM=
STRIPE_TAX_CODE_USER_MANUAL=
STRIPE_TAX_BEHAVIOR=exclusive
STRIPE_AURA_PREMIUM_AMOUNT=12

# ── Google Analytics 4 (dashboard analytics proxy) ────────────────────────────
# api/analytics.js calls the GA4 Data API using a service account.
# GA_CREDENTIALS_JSON: paste the full content of your service account JSON key file
#   (get from Google Cloud Console → IAM → Service Accounts → create key)
# GA_PROPERTY_ID: your GA4 property numeric ID (not the measurement ID G-XXXXXX)
#   (Google Analytics Admin → Property → Settings → Property ID)
GA_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GA_PROPERTY_ID=123456789

# ── Post Studio (editor backend — optional) ───────────────────────────────────
# When EDITOR_API_BASE is set, /admin/ uses a secure save broker instead of
# asking the browser for a GitHub write token.
EDITOR_API_BASE=https://vibrationofawesome.vercel.app/api
# Keep these on Vercel env, not in the public .env file:
EDITOR_SESSION_SECRET=replace_with_a_long_random_string
EDITOR_ALLOWED_ORIGINS=https://vibrationofawesome.com,https://www.vibrationofawesome.com,https://vibrationofawesome.vercel.app,http://localhost:8888,http://localhost:1313
GITHUB_EDITOR_TOKEN=github_token_with_repo_contents_write_access
GITHUB_EDITOR_REPO=Lordshrrred/VibrationofAwesome
GITHUB_EDITOR_BRANCH=main

# ── Vercel (for push-env-to-vercel.js — optional) ─────────────────────────────
# Only needed when running `npm run push:vercel-env` to sync env vars to Vercel.
# VERCEL_TOKEN: https://vercel.com/account/tokens
# VERCEL_PROJECT_ID: Vercel Dashboard → your project → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_guDrrflKSY3FwVbmFMNyQRZyTwI9

# ── VOA Feeder trigger ────────────────────────────────────────────────────────
# Personal Access Token with dispatch permission on Lordshrrred/VOA_Feeder.
# Used by generate-post.js and drip-publish.js to fire the feeder workflow.
VOA_FEEDER_TRIGGER_TOKEN=your_github_pat_for_voa_feeder

# ── Bluesky ───────────────────────────────────────────────────────────────────
# Handle: your full handle e.g. vibrationofawesome.bsky.social
# App Password: generate at https://bsky.app/settings/app-passwords
VOA_BLUESKY_HANDLE=vibrationofawesome.bsky.social
VOA_BLUESKY_APP_PASSWORD=your-app-password-here
# ESR Bluesky — EarthStar Command account (suppressed by default for VOA blog)
ESR_BLUESKY_HANDLE=earthstarrising.bsky.social
ESR_BLUESKY_APP_PASSWORD=your-esr-app-password-here

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Instance: full URL e.g. https://mastodon.social
# Access Token: Settings > Development > New Application
VOA_MASTODON_INSTANCE=https://mastodon.social
VOA_MASTODON_ACCESS_TOKEN=your_voa_mastodon_token
# ESR Mastodon — suppressed by default for VOA blog
ESR_MASTODON_INSTANCE=https://mastodon.social
ESR_MASTODON_ACCESS_TOKEN=your_esr_mastodon_token

# ── Facebook / Meta ───────────────────────────────────────────────────────────
# App credentials (required for long-lived page token exchange)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_USER_TOKEN=your_meta_user_long_lived_token
# VOA Facebook Page
META_PAGE_ID_VOA=your_voa_facebook_page_id
META_PAGE_TOKEN_VOA=your_voa_page_access_token
# EarthStar Facebook Page
META_PAGE_ID_EARTHSTAR=your_earthstar_facebook_page_id
META_PAGE_TOKEN_EARTHSTAR=your_earthstar_page_access_token

# ── Dev.to ────────────────────────────────────────────────────────────────────
# Generate at: https://dev.to/settings/extensions (API Keys section)
DEVTO_API_KEY=your_devto_api_key
# Dev.to username for canonical URL dedup check (default: earthstarrising)
DEVTO_USERNAME=earthstarrising

# ── Tumblr ────────────────────────────────────────────────────────────────────
# Create app at: https://www.tumblr.com/oauth/apps
# GitHub Actions only needs the generic TUMBLR_* vars; VOA_TUMBLR_* are local-only overrides.
TUMBLR_CONSUMER_KEY=your_tumblr_consumer_key
TUMBLR_CONSUMER_SECRET=your_tumblr_consumer_secret
TUMBLR_TOKEN=your_tumblr_oauth_token
TUMBLR_TOKEN_SECRET=your_tumblr_oauth_token_secret
TUMBLR_BLOG_NAME=vibrationofawesome

# ── Publer (Instagram + Threads + Pinterest) ──────────────────────────────────
# API key: https://app.publer.com/settings/api
PUBLER_API_KEY=your_publer_api_key
PUBLER_WORKSPACE_ID=your_publer_workspace_id
# Account IDs — MUST point to VOA accounts, NOT EarthStarRising accounts.
# Verify with: node scripts/syndicate.js --lane boom --slug any-slug (logs [VOA] or [⚠ not VOA])
#   VOA Instagram:  6a0698ee1f0e47d9f3f18a43  ← use this
#   ESR Instagram:  673d135042eebd4131d07ba1  ← do NOT use for VOA blog
#   VOA Threads:    6a069b7979cc0b32f3235166  ← use this
#   ESR Threads:    673d1796bb898aa82fd07bc2  ← do NOT use for VOA blog
PUBLER_INSTAGRAM_ACCOUNT_ID=6a0698ee1f0e47d9f3f18a43
PUBLER_THREADS_ACCOUNT_ID=6a069b7979cc0b32f3235166
# Pinterest account — VOA @awesomevibe (Publer ID: 6a052b620ce3c7cac0c7ebac)
# ESR Pinterest (Publer ID: 673d1b7587c3c20ee4d074c6) — do NOT use for VOA blog
PUBLER_PINTEREST_ACCOUNT_ID=6a052b620ce3c7cac0c7ebac

# ── Pinterest Board IDs (optional per-board overrides) ────────────────────────
# Resolution order: per-board env var → Publer API name-match → DEFAULT_ID → hard-coded fallback
# Without these, the engine name-matches boards via the Publer API on each run.
# Set them for deterministic routing without API calls, or if board names change in Publer.
PUBLER_PINTEREST_BOARD_DEFAULT_ID=641129765641663037
PUBLER_PINTEREST_BOARD_PURPOSE_AND_DIRECTION_ID=
PUBLER_PINTEREST_BOARD_DOPAMINE_DETOX_ID=
PUBLER_PINTEREST_BOARD_NERVOUS_SYSTEM_RESET_ID=
PUBLER_PINTEREST_BOARD_CONSCIOUS_CREATOR_TOOLS_ID=
PUBLER_PINTEREST_BOARD_FIELD_GUIDE_ID=
PUBLER_PINTEREST_BOARD_EARTHSTAR_ID=
PUBLER_PINTEREST_BOARD_EMPOWER_THYSELF_ID=

# ── WordPress.com Direct API ──────────────────────────────────────────────────
# Used for EarthStarRising companion article syndication.
# Run `npm run wordpress-token` once to get an OAuth2 token via browser consent.
# WORDPRESS_OAUTH2_TOKEN is the only var needed at runtime.
WORDPRESS_OAUTH2_TOKEN=your_wordpress_oauth2_token
WORDPRESS_BLOG=https://earthstarrisingsun.wordpress.com
WORDPRESS_CATEGORY_NAMES=EarthStar Rising
WORDPRESS_TAG_NAMES=

# ── Blogger ───────────────────────────────────────────────────────────────────
# Run `npm run blogger-token` once to get a refresh token via browser consent.
BLOGGER_CLIENT_ID=your_blogger_client_id
BLOGGER_CLIENT_SECRET=your_blogger_client_secret
BLOGGER_REFRESH_TOKEN=your_blogger_refresh_token
BLOGGER_BLOG_ID=your_blogger_blog_id

# ── Syndication Engine (advanced — rarely need to change) ─────────────────────
# Per-platform HTTP timeout in milliseconds (default: 90000 = 90 seconds).
# If a Publer media upload or Ideogram generation hangs, the timeout fires
# and the next platform is unblocked. The hung platform is logged as failed
# and retried on the next run.
PLATFORM_TIMEOUT_MS=90000
# Syndication lock stale threshold — if a lock is older than this, it is released.
SYNDICATION_LOCK_STALE_MS=2700000
# Syndication lock wait timeout — how long to wait for a lock before throwing.
SYNDICATION_LOCK_WAIT_MS=3600000
