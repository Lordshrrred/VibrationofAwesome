public/
.hugo_build.lock
.DS_Store
*.code-workspace

# Blog engine
node_modules/
.env

# Syndication cache (token exchange results)
.cache/

# Ebook working copies (source files — do not commit)
TempEbookfolder/
private/

# Email subscriber log — local only, never committed
static/_data/email-subscribers.json
.vercel

# Blog inspiration PDFs ~ never commit source material
static/_data/blog-inspiration/

# Private forbidden terms for PDF privacy checks ~ never commit
.privacy-forbidden.local

# Local collaborator context
/BMO_CONTEXT.md

# Generated at deploy time by scripts/write-build-info.js
static/build-info.json

# Secrets: .env files are symlinks to iCloud Dev Secrets and must never be committed
.env*
!.env.example
!.env*.example
