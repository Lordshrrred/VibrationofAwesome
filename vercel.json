{
  "framework": "hugo",
  "buildCommand": "hugo --minify",
  "outputDirectory": "public",
  "ignoreCommand": "node scripts/vercel-ignore-build.js",
  "cleanUrls": true,
  "env": {
    "HUGO_VERSION": "0.160.0"
  },
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/analytics",
      "destination": "/dashboard/analytics",
      "permanent": false
    },
    {
      "source": "/analytics/",
      "destination": "/dashboard/analytics",
      "permanent": false
    },
    {
      "source": "/api/orchestration-state",
      "destination": "/_data/orchestration-state.json",
      "permanent": false
    },
    {
      "source": "/api/check-url",
      "destination": "/",
      "permanent": false
    },
